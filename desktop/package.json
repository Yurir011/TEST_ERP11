{
  "name": "bench-desktop",
  "productName": "BENCH ERP",
  "version": "0.72.17",
  "private": true,
  "description": "BENCH ERP 데스크톱 클라이언트 (NFC 카드 로그인, 메신저 알림)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "npm run build && node scripts/run-electron.js .",
    "smoke": "npm run build && node scripts/run-electron.js . --smoke",
    "poc": "tsx scripts/nfc-poc.ts",
    "test": "vitest run",
    "typecheck": "tsc -p . --noEmit",
    "start:local": "npm run build && node scripts/run-electron.js . --local",
    "dist": "npm run build && node scripts/write-default-server.js && electron-builder --win --publish never",
    "dist:dir": "npm run build && node scripts/write-default-server.js && electron-builder --win --dir --publish never",
    "bump-version": "tsx scripts/bump-version.ts",
    "publish-release": "tsx scripts/publish-release.ts",
    "mail-e2e": "tsx scripts/mail-e2e.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "imapflow": "2.2.1",
    "mailparser": "3.9.33",
    "nodemailer": "10.0.14",
    "sanitize-html": "2.17.7",
    "serialport": "13.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/mailparser": "3.9.0",
    "@types/node": "24.19.1",
    "@types/sanitize-html": "2.16.2",
    "@types/smtp-server": "3.5.13",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "hoodiecrow-imap": "3.3.1",
    "smtp-server": "3.19.17",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "build": {
    "appId": "kr.co.bench.erp",
    "productName": "BENCH ERP",
    "copyright": "BENCH",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/@serialport/bindings-cpp/prebuilds/{linux-*,darwin-*,android-*,win32-ia32,win32-arm64}/**",
      "!node_modules/better-sqlite3/prebuilds/{linux-*,linuxmusl-*,darwin-*,win32-arm64}.node",
      "!node_modules/better-sqlite3/{deps,src}/**"
    ],
    "asarUnpack": [
      "node_modules/@serialport/bindings-cpp/prebuilds/**",
      "node_modules/better-sqlite3/prebuilds/**"
    ],
    "extraResources": [
      {
        "from": "build-resources",
        "to": ".",
        "filter": [
          "default-server.json"
        ]
      }
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BENCH ERP",
      "deleteAppDataOnUninstall": false,
      "language": "1042",
      "artifactName": "BENCH-ERP_Setup_${version}.exe"
    }
  },
  "benchDefaultServer": "http://www.epik.bio:3102"
}
