LOG_LEVEL=DEBUG
DATABASE_URL=postgresql+psycopg2://erp_user:erp_password@localhost:5432/erp_db
JWT_SECRET_KEY=change-this-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

COMPANY_NAME=주식회사 벤치소프트
COMPANY_CEO_NAME=정혜란
COMPANY_ADDRESS=인천광역시 부평구 주부토로 236 테크노밸리U1센터, A동 S907호
COMPANY_REG_NO=123-45-67890
COMPANY_BIZ_TYPE=서비스업
COMPANY_BIZ_CLASS=소프트웨어 개발
# 실행 환경: development(기본) / production. 운영 서버에서는 production 으로 지정하면
# JWT_SECRET_KEY 가 기본값이거나 짧을 때 서버가 시작되지 않는다.
ENVIRONMENT=development
# 로그 레벨 기본값은 INFO. 개발 PC 에서는 DEBUG 로 두면 디버그 메시지를 볼 수 있다.
# JWT_SECRET_KEY 는 32자 이상의 임의 문자열로 바꿔서 사용한다 (예: python -c "import secrets; print(secrets.token_urlsafe(48))").

# 로그인 시도 제한 (기본값). 같은 이메일로 WINDOW 초 안에 MAX_FAILURES 번 실패하면 LOCKOUT 초 동안 로그인을 막는다.
# LOGIN_MAX_FAILURES=5
# LOGIN_IP_MAX_FAILURES=20
# LOGIN_WINDOW_SECONDS=600
# LOGIN_LOCKOUT_SECONDS=300

# CORS 허용 주소(JSON 배열). 화면은 프록시를 거쳐 같은 주소로 API 를 부르므로 보통은 지정하지 않아도 된다.
# 다른 주소에서 API(8000 포트)를 직접 부르는 경우에만 추가한다. 예: CORS_ORIGINS=["http://localhost:5173","http://192.168.0.10:5173"]
